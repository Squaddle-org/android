<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SquaddleApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Squaddle">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Squaddle">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- android/CLAUDE.md: App Links for https://squaddle.org/j/* with autoVerify=true;
                 the matching assetlinks.json lives in the website repo. autoVerify lets Android
                 open these links directly in the app instead of a browser disambiguation sheet,
                 once the SHA-256 fingerprint below is published there. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="squaddle.org" android:pathPrefix="/j/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
