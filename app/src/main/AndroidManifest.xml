<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- android/CLAUDE.md M4b item 5: UnifiedPush + WorkManager, no FCM. Requested at runtime on
         API 33+ by SignedInApp (MainActivity.kt); SyncAllRoomsWorker checks the grant before
         ever calling notify(), so a denial degrades to "no notifications" rather than a crash -
         the user can still grant it later via system settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SquaddleApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Squaddle">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Squaddle">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- android/CLAUDE.md: App Links for https://squaddle.org/j/* with autoVerify=true;
                 the matching assetlinks.json lives in the website repo. autoVerify lets Android
                 open these links directly in the app instead of a browser disambiguation sheet,
                 once the SHA-256 fingerprint below is published there. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="squaddle.org" android:pathPrefix="/j/" />
            </intent-filter>
        </activity>

        <!-- UnifiedPush's own callback contract (android-connector) - must not be exported and
             must declare exactly this action, both per unifiedpush.org's own docs. -->
        <service
            android:name=".push.SquaddlePushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- ui/room/CalendarExport.kt's .ics share - a plain file:// URI can't cross the
             ACTION_SEND package boundary on API 24+, so this is required, not optional. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
