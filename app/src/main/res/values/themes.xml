<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Manifest-level theme only (first-frame/launch background) - the real Material3 theming
         (light+dark ColorScheme) is applied by Compose itself in ui/theme/Theme.kt. No
         android:statusBarColor here: MainActivity.onCreate calls enableEdgeToEdge(), which draws
         transparent system bars with auto light/dark icon contrast - API 35+ enforces this
         regardless, this just opts in below that on API 26..34 too, matching the running
         emulator's API 34. -->
    <style name="Theme.Squaddle" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/squaddle_background_light</item>
    </style>
</resources>
